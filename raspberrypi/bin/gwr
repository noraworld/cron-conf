#!/bin/sh

# https://chatgpt.com/c/6af57ca6-fc38-83ee-8bc6-b17236e82307
# codex://threads/01a1d927-7de5-7ff1-8bd4-b0426b3f64f8

GHC_FROM="$(basename "$0") $*"
export GHC_FROM

REPO=""
WORKFLOW=""
# Includes the initial execution (at most four reruns).
MAX_ATTEMPTS=5
POLL_INTERVAL=60
MAX_POLL_COUNT=180 # Roughly 3 hours per attempt, including queue time.
MAX_API_FAILURES=5

log() {
  printf 'diary-batch-runner [%s %s]: %s\n' "$REPO" "$WORKFLOW" "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: diary-batch-runner --repo OWNER/REPO --workflow FILE_OR_ID [options]

Required:
  --repo OWNER/REPO       Repository containing the workflow
  --workflow FILE_OR_ID  Workflow file name or numeric ID

Options (positive integers):
  --max-attempts N        Total attempts including the initial run (default: 5)
  --poll-interval N       Seconds between status checks (default: 60)
  --max-poll-count N      Maximum status checks per attempt (default: 180)
  --max-api-failures N    Maximum consecutive API failures (default: 5)
  -h, --help             Show this help

Options accept both --name VALUE and --name=VALUE.
EOF
}

positive_integer() {
  case "$2" in
    ''|*[!0-9]*)
      log "$1 must be a positive integer."
      return 1
      ;;
  esac
  # Keep values within a range supported by both 32-bit and 64-bit shells.
  if ! { [ "$2" -gt 0 ] && [ "$2" -le 2147483647 ]; } 2>/dev/null; then
    log "$1 must be between 1 and 2147483647."
    return 1
  fi
}

parse_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --*=*)
        option=${1%%=*}
        value=${1#*=}
        shift
        set -- "$option" "$value" "$@"
        ;;
    esac
    case "$1" in
      --repo|--workflow|--max-attempts|--poll-interval|--max-poll-count|--max-api-failures)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          log "Missing value for $1."
          return 1
        fi
        case "$2" in
          --*) log "Missing value for $1."; return 1 ;;
        esac
        case "$1" in
          --repo) REPO=$2 ;;
          --workflow) WORKFLOW=$2 ;;
          *)
            positive_integer "$1" "$2" || return 1
            case "$1" in
              --max-attempts) MAX_ATTEMPTS=$2 ;;
              --poll-interval) POLL_INTERVAL=$2 ;;
              --max-poll-count) MAX_POLL_COUNT=$2 ;;
              --max-api-failures) MAX_API_FAILURES=$2 ;;
            esac
            ;;
        esac
        shift 2
        ;;
      -h|--help) usage; return 2 ;;
      *) log "Unknown option or unexpected argument: $1"; return 1 ;;
    esac
  done
  if [ -z "$REPO" ] || [ -z "$WORKFLOW" ]; then
    log "Both --repo and --workflow are required."
    return 1
  fi
}

# Return 0 for success, 2 for a completed unsuccessful run, or 1 for
# monitoring errors. A monitoring error must never trigger a rerun.
wait_for_run() {
  poll_count=0
  api_failures=0
  while [ "$poll_count" -lt "$MAX_POLL_COUNT" ]; do
    poll_count=$((poll_count + 1))
    if run_info=$(ghc api "repos/$REPO/actions/runs/$run_id" \
      --jq '[.run_attempt, .status, (.conclusion // "pending")] | join(" ")'); then
      api_failures=0
      read -r observed_attempt status conclusion <<EOF
$run_info
EOF
      case "$observed_attempt" in
        ''|*[!0-9]*)
          log "Invalid run status for $run_id."
          return 1
          ;;
      esac
      # GitHub can briefly return the previous attempt after accepting a rerun.
      if [ "$observed_attempt" -ge "$expected_attempt" ] && [ "$status" = "completed" ]; then
        log "Run $run_id attempt $observed_attempt: $conclusion."
        [ "$conclusion" = "success" ] && return 0
        return 2
      fi
    else
      api_failures=$((api_failures + 1))
      log "Unable to retrieve run $run_id ($api_failures/$MAX_API_FAILURES)."
      [ "$api_failures" -ge "$MAX_API_FAILURES" ] && return 1
    fi
    sleep "$POLL_INTERVAL"
  done
  log "Timed out monitoring run $run_id; check it before starting another batch."
  return 1
}

run_workflow() {
  # flock is provided by util-linux on the Raspberry Pi. Do not queue cron
  # invocations or unlink this file: the lock is released when this process exits.
  command -v flock >/dev/null 2>&1 || {
    log "flock is required."
    return 1
  }
  flock -n -E 75 9 || {
    lock_status=$?
    if [ "$lock_status" -eq 75 ]; then
      log "Another batch runner is active; skipping."
      return 0
    fi
    log "Unable to acquire the batch runner lock."
    return 1
  }

  ref=$(ghc api "repos/$REPO" --jq .default_branch) || return 1
  [ -n "$ref" ] || return 1

  # This API version returns the dispatched run's ID directly. Never select
  # the latest run from a list: it might belong to another caller.
  # Do not retry dispatch on errors: GitHub may already have accepted it.
  run_id=$(ghc api --method POST "repos/$REPO/actions/workflows/$WORKFLOW/dispatches" \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    -f "ref=$ref" --jq .workflow_run_id) || {
    log "Dispatch failed; check GitHub Actions before starting another batch."
    return 1
  }
  case "$run_id" in
    ''|*[!0-9]*|0)
      log "Dispatch did not return a valid run ID; check GitHub Actions."
      return 1
      ;;
  esac
  log "Monitoring https://github.com/$REPO/actions/runs/$run_id"

  attempt=1
  expected_attempt=1
  while [ "$attempt" -le "$MAX_ATTEMPTS" ]; do
    wait_for_run
    result=$?
    case "$result" in
      0) return 0 ;;
      2) ;; # Only a confirmed unsuccessful completion permits a rerun.
      *) return 1 ;;
    esac
    if [ "$attempt" -eq "$MAX_ATTEMPTS" ]; then
      log "Run $run_id failed after $MAX_ATTEMPTS attempts."
      return 1
    fi

    expected_attempt=$((observed_attempt + 1))
    ghc run rerun "$run_id" --failed --repo "$REPO" || {
      log "Unable to rerun $run_id; check GitHub Actions."
      return 1
    }
    attempt=$((attempt + 1))
    log "Requested attempt $attempt/$MAX_ATTEMPTS (failed jobs and their dependents only)."
    sleep "$POLL_INTERVAL"
  done
}

main() {
  parse_options "$@"
  parse_status=$?
  case "$parse_status" in
    0) ;;
    2) return 0 ;;
    *) return 1 ;;
  esac

  # Hash the pair to keep arbitrary names out of paths and to avoid filename
  # length limits. Different repositories/workflows must not share a lock.
  command -v sha256sum >/dev/null 2>&1 || {
    log "sha256sum is required."
    return 1
  }
  lock_hash=$(printf '%s\000%s\000' "$REPO" "$WORKFLOW" | sha256sum) || return 1
  lock_hash=${lock_hash%% *}
  # Keep the descriptor open throughout monitoring; never unlink a lock file.
  run_workflow 9>"${TMPDIR:-/tmp}/diary-batch-runner-$(id -u)-$lock_hash.lock"
}

main "$@"
